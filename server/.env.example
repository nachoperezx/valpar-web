# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/valpar"

# Clave para firmar las sesiones (JWT). Obligatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001
NODE_ENV=development

# Distancia máxima (metros) entre el usuario y el local para validar un check-in
CHECKIN_MAX_DISTANCE_METERS=150

# Solo desarrollo: permite check-ins sin estar físicamente en el local
ALLOW_REMOTE_CHECKIN=false

# Google OAuth (IDs de cliente aceptados al verificar el token de Google)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
